{
  "name": "post2md",
  "short_name": "post2md",
  "description": "Turn an X or Threads post or thread into markdown plus images for an LLM.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#14181f",
  "theme_color": "#1d2430",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
